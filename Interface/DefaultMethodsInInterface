
 
public class Test {
	 interface vechile{
		  
		   default void  stop() {
			   System.out.println("vechile stoped");
		   }
	  }

 interface traffic{
		   default void  stop() {
			   System.out.println("signal stoped");
		   } 
	  }
	 
	 
	 class Bike implements vechile,traffic{  //ambiguity problem
		  @Override
		  public void stop() {
			  traffic.super.stop();
		  }
}
	 
	 class Car implements vechile{	  
	 }

	 public void handlingMultipleIngheritanceDefaultMethods() {
		 Bike b=new Bike();
		 b.stop();
	}
	 
	 public void m1() {
	 Car c=new Car();
	 c.stop();
		
	}
	 
	 
	 
	 
	 public static void main(String[] args) {
